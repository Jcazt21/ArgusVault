export global Theme {
    // Two neutral layers: `bg` is the content canvas, `sidebar` sits one step darker so the
    // entry list reads as navigation and the detail pane as the working surface.
    // Pure grayscale. Color is reserved for meaning: red = warning/destructive, green = ok.
    out property <color> bg: #121212;
    out property <color> sidebar: #0B0B0B;
    out property <color> surface: #1A1A1A;
    out property <color> surface-hi: #262626;
    out property <color> border: #333333;
    // `accent` is the neutral emphasis color (primary buttons, focus ring): near-white.
    out property <color> accent: #E8E8E8;
    out property <color> accent-hi: #FFFFFF;
    out property <color> accent-lo: #BDBDBD;
    out property <color> text: #EDEDED;
    out property <color> muted: #8F8F8F;
    out property <color> danger: #E5484D;
    out property <color> danger-hi: #FF6369;
    out property <color> ok: #3FB950;
    out property <color> ok-hi: #5FD16F;
    out property <color> on-accent: #111111;

    out property <length> radius: 8px;
    out property <duration> fast: 120ms;
}

// Single-line text field with a caption above it (or a taller multi-line one for notes).
//
// `secret` fields mask their text, but Slint's password input type does NOT
// stop Ctrl+C / Ctrl+X from putting the real text on the system clipboard
// (verified by running the app). The capture handler below swallows the copy
// and cut shortcuts before the TextInput sees them, so a secret can only reach
// the clipboard through the protected path in `argus-platform`.
export component Field inherits VerticalLayout {
    in-out property <string> text <=> input.text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    // Several lines (notes). Enter then inserts a line break instead of firing `accepted`.
    in property <bool> multiline: false;
    in property <bool> enabled: true;
    callback edited(string);
    // Enter pressed in the field.
    callback accepted();
    // Escape pressed in the field.
    callback escaped();

    spacing: 6px;
    // Lets callers do `some-field.focus()`: the focus lands on the text input.
    forward-focus: input;

    // No caption (e.g. the search box) means no caption row, so the field is exactly 40 px tall.
    if root.label != "": Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
    }

    box := Rectangle {
        height: root.multiline ? 96px : 40px;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        opacity: root.enabled ? 1.0 : 0.5;
        animate border-color { duration: Theme.fast; easing: ease-out; }

        // `forward-focus` keeps Tab from stopping twice per field (scope, then text input).
        FocusScope {
            forward-focus: input;
            enabled: root.enabled;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.escaped();
                    return EventResult.accept;
                }
                if (root.secret) {
                    if ((event.modifiers.control || event.modifiers.meta)
                        && (event.text == "c" || event.text == "C" || event.text == "x" || event.text == "X"
                            || event.text == "\u{3}" || event.text == "\u{18}" || event.text == Key.Insert)) {
                        return EventResult.accept;
                    }
                    if (event.modifiers.shift && event.text == Key.Delete) {
                        return EventResult.accept;
                    }
                }
                return EventResult.reject;
            }

            input := TextInput {
                x: 12px;
                y: root.multiline ? 10px : 0px;
                width: box.width - 24px;
                height: root.multiline ? box.height - 20px : box.height;
                vertical-alignment: root.multiline ? top : center;
                single-line: !root.multiline;
                wrap: root.multiline ? word-wrap : no-wrap;
                enabled: root.enabled;
                font-size: 14px;
                color: Theme.text;
                selection-background-color: Theme.accent-lo;
                selection-foreground-color: Theme.on-accent;
                input-type: root.secret ? InputType.password : InputType.text;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
        }

        if input.text == "": Text {
            x: 12px;
            y: root.multiline ? 10px : 0px;
            height: root.multiline ? 20px : parent.height;
            vertical-alignment: root.multiline ? top : center;
            text: root.placeholder;
            font-size: 14px;
            color: Theme.muted;
        }
    }
}

// Button. Variants: `primary` (the one action of the view), default (secondary),
// `quiet` (text-only, no fill), `danger` (filled, for a confirmed destructive step) and
// `quiet-danger` (red text, for the first step of a destructive action).
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> quiet: false;
    in property <bool> quiet-danger: false;
    in property <bool> active: true;
    callback clicked();

    height: 40px;
    min-width: 88px;
    border-radius: Theme.radius;
    opacity: root.active ? 1.0 : 0.45;
    background: root.primary ? (area.pressed ? Theme.accent-lo : area.has-hover ? Theme.accent-hi : Theme.accent)
        : root.danger ? (area.pressed ? Theme.danger : area.has-hover ? Theme.danger-hi : Theme.danger)
        : (area.pressed ? Theme.border : area.has-hover ? Theme.surface-hi : root.quiet || root.quiet-danger ? transparent : Theme.surface);
    border-width: root.primary || root.danger || root.quiet || root.quiet-danger ? 0px : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.fast; easing: ease-out; }

    // Keyboard: Tab reaches the button, Enter or Space presses it.
    FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        // Focus ring, drawn just outside the button.
        if self.has-focus: Rectangle {
            x: -3px;
            y: -3px;
            width: root.width + 6px;
            height: root.height + 6px;
            border-radius: Theme.radius + 3px;
            border-width: 2px;
            border-color: Theme.text;
        }
    }

    // Above the focus scope, so one click both presses and focuses.
    area := TouchArea {
        enabled: root.active;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: root.primary || root.danger ? Theme.on-accent
            : root.quiet-danger ? Theme.danger
            : root.quiet ? Theme.muted : Theme.text;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Inline message box for notices (accent), errors (danger) and confirmations (ok).
// Tinted from its own hue, not gray.
export component Banner inherits Rectangle {
    in property <string> message;
    in property <bool> error: false;
    in property <bool> ok: false;

    property <color> hue: root.error ? Theme.danger : root.ok ? Theme.ok : Theme.accent;

    background: root.hue.with-alpha(root.error ? 0.12 : 0.08);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.hue.with-alpha(root.error ? 0.35 : 0.2);
    // Fixed to the text, so a scrolling pane (which sizes its content to the minimum) keeps it.
    preferred-height: msg.preferred-height + 20px;
    min-height: msg.preferred-height + 20px;

    msg := Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text: root.message;
        color: root.error ? Theme.danger-hi : root.ok ? Theme.ok-hi : Theme.text;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component Label inherits Text {
    color: Theme.muted;
    font-size: 12px;
}

// Section heading inside a pane.
export component Heading inherits Text {
    color: Theme.text;
    font-size: 22px;
    font-weight: 700;
}

// One row of the detail card: label on the left, value right-aligned, optional icon buttons
// (the children) at the end, and a hairline underneath unless it is the last row.
export component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    in property <bool> last: false;
    // An interactive row is "engaged" while the pointer is over it or it has keyboard focus
    // (Tab). It highlights, reports engage changes, and activates on click, Enter or Space.
    in property <bool> interactive: false;
    out property <bool> engaged: row-area.has-hover || row-focus.has-focus;
    callback hover-changed(bool);
    callback activated();

    height: 52px;
    background: root.engaged ? Theme.surface-hi : transparent;
    animate background { duration: Theme.fast; easing: ease-out; }

    changed engaged => {
        root.hover-changed(root.engaged);
    }

    // Declared before the children so their own buttons stay on top of it.
    row-focus := FocusScope {
        enabled: root.interactive;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // Above the focus scope, so one click both presses and focuses.
    row-area := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
    // Inset focus ring.
    if row-focus.has-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.muted;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            width: 88px;
            text: root.label;
            color: Theme.muted;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.value == "" ? "—" : root.value;
            color: root.value == "" ? Theme.muted : Theme.text;
            font-size: root.mono ? 15px : 14px;
            font-family: root.mono ? "Consolas" : "";
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }

    if !root.last: Rectangle {
        y: parent.height - 1px;
        x: 16px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.border;
    }
}

// Entry icon on a raised tile: a globe for websites, a monitor for servers.
export component Glyph inherits Rectangle {
    in property <length> size: 36px;
    in property <bool> server: false;
    // A bundled brand icon (single-colour vector), tinted to follow the theme.
    in property <image> icon;
    in property <bool> has-icon: false;

    width: root.size;
    height: root.size;
    border-radius: root.size / 4;
    background: Theme.surface-hi;

    if root.has-icon: Image {
        source: root.icon;
        colorize: Theme.accent-lo;
        width: root.size * 0.52;
        height: root.size * 0.52;
        image-fit: contain;
    }

    // Website: circle with an equator and a meridian.
    if !root.server && !root.has-icon: Rectangle {
        width: root.size * 0.5;
        height: root.size * 0.5;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: Theme.muted;
        Rectangle {
            width: parent.width;
            height: 1.5px;
            background: Theme.muted;
        }
        Rectangle {
            width: parent.width * 0.4;
            height: parent.height;
            border-radius: self.width / 2;
            border-width: 1.5px;
            border-color: Theme.muted;
        }
    }

    // Server: a screen on a short stand.
    if root.server: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.27;
        width: root.size * 0.52;
        height: root.size * 0.34;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: Theme.muted;
    }
    if root.server: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.27 + root.size * 0.34;
        width: 1.5px;
        height: root.size * 0.1;
        background: Theme.muted;
    }
    if root.server: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height * 0.27 + root.size * 0.44;
        width: root.size * 0.28;
        height: 1.5px;
        background: Theme.muted;
    }
}

// Square "+" button, same size as a field so it lines up with the search box.
export component PlusIcon inherits Rectangle {
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: area.pressed ? Theme.border : area.has-hover ? Theme.surface-hi : Theme.surface;
    animate background { duration: Theme.fast; easing: ease-out; }

    Rectangle {
        width: 14px;
        height: 2px;
        background: area.has-hover ? Theme.text : Theme.muted;
    }
    Rectangle {
        width: 2px;
        height: 14px;
        background: area.has-hover ? Theme.text : Theme.muted;
    }

    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// "Copy" icon: two overlapping outlined squares, on a round hover tile.
export component CopyIcon inherits Rectangle {
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: area.pressed ? Theme.border : area.has-hover ? Theme.surface-hi : transparent;
    animate background { duration: Theme.fast; easing: ease-out; }

    Rectangle {
        x: 10px;
        y: 7px;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: area.has-hover ? Theme.text : Theme.muted;
    }
    Rectangle {
        x: 8px;
        y: 11px;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: area.has-hover ? Theme.text : Theme.muted;
        background: area.pressed ? Theme.border : area.has-hover ? Theme.surface-hi : Theme.sidebar;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Argus: the many-eyed watchman. A single open eye, drawn with plain shapes.
export component Mark inherits Rectangle {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 2px;
    border-color: Theme.accent;
    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
    }
}

// Small filter pill.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active ? Theme.surface-hi : area.has-hover ? Theme.surface : transparent;
    preferred-width: txt.preferred-width + 24px;
    animate background { duration: Theme.fast; easing: ease-out; }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        if self.has-focus: Rectangle {
            border-width: 2px;
            border-radius: 14px;
            border-color: Theme.text;
        }
    }

    // Above the focus scope, so one click both presses and focuses.
    area := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    txt := Text {
        text: root.label;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Labelled on/off switch.
export component Switch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    callback toggled(bool);

    height: 36px;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        if self.has-focus: Rectangle {
            border-width: 2px;
            border-radius: Theme.radius;
            border-color: Theme.muted;
        }
    }

    // Above the focus scope, so one click both presses and focuses.
    area := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    HorizontalLayout {
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Theme.ok : Theme.border;
                animate background { duration: Theme.fast; easing: ease-out; }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: root.checked ? Theme.on-accent : Theme.accent;
                    animate x { duration: Theme.fast; easing: ease-out; }
                }
            }
        }
    }
}

// Two-or-more way choice (entry kind, generator mode).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current: 0;
    callback selected(int);

    height: 40px;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow && root.current > 0) {
                root.current = root.current - 1;
                root.selected(root.current);
                return EventResult.accept;
            }
            if (event.text == Key.RightArrow && root.current < root.options.length - 1) {
                root.current = root.current + 1;
                root.selected(root.current);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        if self.has-focus: Rectangle {
            border-width: 2px;
            border-radius: Theme.radius;
            border-color: Theme.text;
        }
    }
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            border-radius: Theme.radius - 2px;
            background: root.current == i ? Theme.surface-hi : seg-area.has-hover ? Theme.surface-hi.with-alpha(0.5) : transparent;
            animate background { duration: Theme.fast; easing: ease-out; }
            Text {
                text: option;
                color: root.current == i ? Theme.text : Theme.muted;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-area := TouchArea {
                clicked => {
                    root.current = i;
                    root.selected(i);
                }
            }
        }
    }
}

// Whole-number stepper: "− 24 +".
export component Stepper inherits Rectangle {
    in property <string> label;
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;

    height: 40px;

    HorizontalLayout {
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        Btn {
            label: "−";
            min-width: 40px;
            max-width: 40px;
            active: root.value > root.minimum;
            clicked => {
                root.value = max(root.minimum, root.value - root.step);
            }
        }
        Text {
            width: 36px;
            text: root.value;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Btn {
            label: "+";
            min-width: 40px;
            max-width: 40px;
            active: root.value < root.maximum;
            clicked => {
                root.value = min(root.maximum, root.value + root.step);
            }
        }
    }
}

// Text field with a "Browse…" button for picking a file.
export component PathField inherits VerticalLayout {
    in-out property <string> text <=> field.text;
    in property <string> label;
    in property <string> placeholder;
    callback accepted();
    callback browse();

    spacing: 6px;
    forward-focus: field;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 600;
    }
    HorizontalLayout {
        spacing: 8px;
        field := Field {
            placeholder: root.placeholder;
            accepted => {
                root.accepted();
            }
        }
        Btn {
            label: "Browse…";
            min-width: 88px;
            clicked => {
                root.browse();
            }
        }
    }
}
